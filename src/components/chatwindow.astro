---
const messages = [
  { from: "you", text: "Hello! 👋" },
  { from: "ai", text: "Hi Cindy, I’m right here \u{1F60C}" },
  { from: "you", text: "Testing the chat UI!" },
  { from: "ai", text: "Looks good so far \u{1F44C}" },
];
---

<style>
  .chat-container {
    display: flex;
    flex-direction: column;
    height: 80vh;
    width: 100%;
    max-width: 420px;
    margin: 0 auto;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.08);
    padding: 12px;
    overflow: hidden;
    border: 1px solid #e7e7e7;
  }

  .messages {
    flex: 1;
    overflow-y: auto;
    padding: 10px;
  }

  .bubble {
    max-width: 70%;
    padding: 10px 14px;
    border-radius: 18px;
    margin-bottom: 12px;
    font-size: 15px;
    line-height: 1.4;
  }

  /* user's bubble (right side) */
  .you {
    background: #d2f8d2;
    align-self: flex-end;
    border-bottom-right-radius: 4px;
  }

  /* AI bubble (left side) */
  .ai {
    background: #f1f1f1;
    align-self: flex-start;
    border-bottom-left-radius: 4px;
  }

  .input-bar {
    display: flex;
    gap: 8px;
    padding: 8px;
    border-top: 1px solid #ddd;
  }

  .text-input {
    flex: 1;
    border: 1px solid #ccc;
    border-radius: 20px;
    padding: 10px 14px;
    font-size: 15px;
    outline: none;
  }

  .send-btn {
    background: #25d366;
    color: white;
    border: none;
    padding: 0 18px;
    border-radius: 18px;
    font-weight: 600;
    cursor: pointer;
  }
</style>


<div class="chat-container">
  <div class="messages">
    {messages.map((msg) => (
      <div class={`bubble ${msg.from}`}>
        {msg.text}
      </div>
    ))}
  </div>

  <div class="input-bar">
    <input class="text-input" type="text" placeholder="Type a message..." />
    <button class="send-btn">Send</button>
  </div>
</div>
